# Copy this file to .env and fill in your values before running the bridge.
PORT=8787
BIND_ADDR=0.0.0.0

# Path to the local git repository you want to code remotely on this PC.
# Example on Windows: REPO_DIR=C:\Users\NamaKamu\Documents\project-percobaan
REPO_DIR=.

# Secret token shared with the WynnDiff Flutter app (tab Host -> Bridge Token).
BRIDGE_TOKEN=ganti-dengan-token-rahasia-kamu

# OpenRouter / OpenAI-compatible AI Gateway
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
AI_GATEWAY_URL=https://openrouter.ai/api/v1
